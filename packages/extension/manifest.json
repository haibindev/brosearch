{
  "manifest_version": 3,
  "name": "brosearch",
  "version": "0.1.0",
  "description": "Bridge between brosearch daemon and your Chrome session",
  "permissions": [
    "debugger",
    "tabs",
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "brosearch"
  }
}
